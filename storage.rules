rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid));
    }
    match /music/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
  }
}